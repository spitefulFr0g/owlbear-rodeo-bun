#!/bin/sh
# Runs the checks CI runs, for the half of the repo the commit touches.
# Quiet when they pass; prints the end of the failing check's output when not.
# Turn it on once per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
log=$(mktemp)
trap 'rm -f "$log"' EXIT

check() {
  if ! "$@" >"$log" 2>&1; then
    echo "pre-commit: '$*' failed in $(pwd)" >&2
    tail -n 40 "$log" >&2
    exit 1
  fi
}

if ! git diff --cached --quiet -- backend src public index.html vite.config.mjs .env .env.production package.json yarn.lock tsconfig.json scripts .githooks .github/workflows; then
  cd "$root" || exit 1
  check node scripts/frontend.cjs setup
fi

if ! git diff --cached --quiet -- backend src/sceneRules src/scene package.json yarn.lock; then
  cd "$root/backend" || exit 1
  check bun run typecheck
  check bun run test
  check bun run lint
fi

if ! git diff --cached --quiet -- src public index.html vite.config.mjs .env .env.production tsconfig.json package.json yarn.lock scripts .githooks .github/workflows/frontend.yml; then
  cd "$root" || exit 1
  check node scripts/frontend.cjs check
fi
