{
  "name": "owlbear-rodeo-server",
  "version": "0.5.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "bun scripts/embed-frontend.ts && bun src/index.ts",
    "dev": "bun scripts/embed-frontend.ts && bun --watch src/index.ts --allow-origin '^http://localhost:3000$'",
    "test": "bun test ./src ../src/sceneRules ../src/scene",
    "typecheck": "bun scripts/embed-frontend.ts && tsc --noEmit",
    "build:frontend": "bun scripts/build-frontend.ts",
    "build": "bun scripts/build.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "smoke": "bun scripts/embed-frontend.ts && bun scripts/smoke.ts",
    "browse": "bun scripts/embed-frontend.ts && bun scripts/browse.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.3",
    "helmet": "^5.0.2",
    "socket.io": "^4.8.4",
    "socket.io-msgpack-parser": "^3.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^5.18.0",
    "@typescript-eslint/parser": "^5.18.0",
    "eslint": "^8.12.0",
    "socket.io-client": "^4.5.4",
    "typescript": "^5"
  }
}
